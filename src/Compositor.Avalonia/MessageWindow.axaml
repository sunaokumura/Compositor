<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Compositor.MessageWindow"
        Title="Compositor" Width="420" Height="150" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="12" Spacing="12">
    <TextBlock x:Name="Message" TextWrapping="Wrap"/>
    <Button Content="OK" Width="80" HorizontalAlignment="Right" Click="OnOk"/>
  </StackPanel>
</Window>
